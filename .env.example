# Local development only. Replace database credentials before deploying.
DATABASE_URL="postgresql://ember:ember_local_only@127.0.0.1:5432/ember?schema=public"
# For Codespaces, set this to the exact public HTTPS browser origin (no path).
# See docs/CODESPACES-LOGIN.md. Never add wildcards or trust incoming Host headers.
APP_ORIGIN="http://localhost:3000"
# Explicit opt-in seed account. Required only when creating the initial administrator.
SEED_ADMIN_EMAIL="admin@example.test"
# Set your own password of at least 12 characters. Never commit it.
SEED_ADMIN_PASSWORD=""
